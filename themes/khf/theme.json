{
 "$schema": "https://schemas.wp.org/trunk/theme.json",
 "version": 3,
 "slug": "khf",
 "title": "Kinzua Heritage",
 "description": "Native block theme for the Kinzua Heritage Festival with Seneca Nation design elements.",
 "settings": {
  "appearanceTools": true,
  "useRootPaddingAwareAlignments": true,
  "color": {
   "defaultDuotone": false,
   "defaultGradients": true,
   "defaultPalette": true,
   "custom": true,
   "customGradient": true,
   "palette": [
    {
     "slug": "seneca-purple",
     "name": "Seneca Purple (Wampum)",
     "color": "#7a3b9e"
    },
    {
     "slug": "wampum-white",
     "name": "Wampum White",
     "color": "#ffffff"
    },
    {
     "slug": "bark-brown",
     "name": "Bark Brown",
     "color": "#4a3a2a"
    },
    {
     "slug": "forest-green",
     "name": "Forest Green",
     "color": "#2d5a33"
    },
    {
     "slug": "sunset-gold",
     "name": "Sunset Gold",
     "color": "#d4af37"
    },
    {
     "slug": "sky-blue",
     "name": "Sky Blue",
     "color": "#8ed1fc"
    },
    {
     "slug": "text-dark",
     "name": "Text Dark",
     "color": "#111111"
    },
    {
     "slug": "text-light",
     "name": "Text Light",
     "color": "#f5f5f5"
    }
   ],
   "gradients": [
    {
     "slug": "wooded-glen",
     "name": "Wooded Glen",
     "gradient": "linear-gradient(160deg, #2d5a33 0%, #4a3a2a 100%)"
    },
    {
     "slug": "wampum-sunset",
     "name": "Wampum Sunset",
     "gradient": "linear-gradient(135deg, #7a3b9e 0%, #d4af37 50%, #4a3a2a 100%)"
    }
   ]
  },
  "spacing": {
   "defaultSpacingSizes": false,
   "units": [
    "px",
    "rem",
    "vh",
    "em",
    "%"
   ],
   "spacingSizes": [
    {
     "slug": "xxs",
     "name": "Extra Extra Small",
     "size": "0.25rem"
    },
    {
     "slug": "xs",
     "name": "Extra Small",
     "size": "0.5rem"
    },
    {
     "slug": "sm",
     "name": "Small",
     "size": "1rem"
    },
    {
     "slug": "md",
     "name": "Medium",
     "size": "1.5rem"
    },
    {
     "slug": "lg",
     "name": "Large",
     "size": "2.5rem"
    },
    {
     "slug": "xl",
     "name": "Extra Large",
     "size": "4rem"
    },
    {
     "slug": "xxl",
     "name": "Extra Extra Large",
     "size": "6rem"
    }
   ]
  },
  "layout": {
   "contentSize": "1200px",
   "wideSize": "1424px"
  },
  "typography": {
   "defaultFontSizes": false,
   "fluid": false,
   "dropCap": true,
   "fontStyle": true,
   "textDecoration": true,
   "textTransform": true,
   "fontSizes": [
    {
     "slug": "huge",
     "name": "Huge",
     "size": "4rem"
    },
    {
     "slug": "large",
     "name": "Large",
     "size": "2.5rem"
    },
    {
     "slug": "medium",
     "name": "Medium",
     "size": "1.5rem"
    },
    {
     "slug": "regular",
     "name": "Regular",
     "size": "1.125rem"
    },
    {
     "slug": "small",
     "name": "Small",
     "size": "0.875rem"
    },
    {
     "slug": "tiny",
     "name": "Tiny",
     "size": "0.75rem"
    }
   ],
   "fontFamilies": [
    {
     "slug": "display",
     "name": "Display",
     "fontFamily": "'Cormorant Garamond', serif"
    },
    {
     "slug": "body",
     "name": "Body",
     "fontFamily": "'Inter', sans-serif"
    },
    {
     "slug": "glyph",
     "name": "Glyph",
     "fontFamily": "'Source Serif Pro', serif"
    }
   ]
  }
 },
 "styles": {
  "color": {
   "background": "#ffffff",
   "text": "#111111"
  },
  "typography": {
   "fontFamily": "var(--wp--preset--font-family-body)",
   "fontSize": "var(--wp--preset--font-size-regular)",
   "lineHeight": "1.7"
  },
  "spacing": {
   "blockGap": "var(--wp--preset--spacing-md)"
  },
  "elements": {
   "link": {
    "color": {
     "text": "#7a3b9e"
    },
    "typography": {
     "textDecoration": "underline"
    },
    ":hover": {
     "color": {
      "text": "#5a2a83"
     },
     "typography": {
      "textDecoration": "underline"
     }
    },
    ":focus-visible": {
     "color": {
      "text": "#5a2a83"
     },
     "typography": {
      "textDecoration": "underline"
     }
    }
   },
   "button": {
    "color": {
     "background": "#7a3b9e",
     "text": "#ffffff"
    },
    "border": {
     "radius": "0.5rem"
    },
    "spacing": {
     "padding": {
      "top": "0.75rem",
      "bottom": "0.75rem",
      "left": "1.5rem",
      "right": "1.5rem"
     }
    },
    "typography": {
     "fontWeight": "500"
    },
    ":hover": {
     "color": {
      "background": "#5a2a83"
     }
    },
    ":focus-visible": {
     "color": {
      "background": "#4a2270"
     },
     "border": {
      "color": "#d4af37",
      "width": "2px"
     }
    }
   },
   "heading": {
    "color": {
     "text": "#4a3a2a"
    },
    "typography": {
     "fontFamily": "var(--wp--preset--font-family-display)",
     "lineHeight": "1.3"
    }
   }
  },
  "blocks": {
   "core/button": {
    "color": {
     "background": "#7a3b9e",
     "text": "#ffffff"
    },
    "border": {
     "radius": "0.5rem"
    },
    "spacing": {
     "padding": {
      "top": "0.75rem",
      "bottom": "0.75rem",
      "left": "1.5rem",
      "right": "1.5rem"
     }
    },
    "typography": {
     "fontWeight": "500"
    }
   },
   "core/heading": {
    "typography": {
     "fontFamily": "var(--wp--preset--font-family-display)",
     "lineHeight": "1.3"
    }
   },
   "core/separator": {
    "border": {
     "color": "#7a3b9e",
     "style": "solid",
     "width": "0 0 3px 0"
    },
    "color": {
     "text": "#ffffff"
    }
   },
   "core/group": {
    "border": {
     "style": "solid",
     "width": "0",
     "color": "#7a3b9e"
    }
   },
   "core/navigation": {
    "elements": {
     "link": {
      "color": {
       "text": "var:preset(color,seneca-purple)"
      },
      "typography": {
       "textDecoration": "none"
      },
      ":hover": {
       "color": {
        "text": "var:preset(color,forest-green)"
       },
       "typography": {
        "textDecoration": "underline"
       }
      }
     }
    }
   }
  }
 },
 "templateParts": [
  {
   "name": "header",
   "title": "Header",
   "area": "header"
  },
  {
